{
  "name": "wfh-monitoring-backend",
  "version": "1.0.0",
  "description": "NestJS microservices backend (API Gateway + Employee Service + Attendance Service) for the WFH Attendance & Employee Monitoring System",
  "author": "Abdurrahman Khairi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build employee-service && nest build attendance-service && nest build api-gateway",
    "start:employee": "nest start employee-service --watch",
    "start:attendance": "nest start attendance-service --watch",
    "start:gateway": "nest start api-gateway --watch",
    "start:dev": "concurrently -n EMP,ATT,GW -c blue,magenta,green \"npm:start:employee\" \"npm:start:attendance\" \"npm:start:gateway\"",
    "start:all": "concurrently -n EMP,ATT,GW -c blue,magenta,green \"npm:start:prod:employee\" \"npm:start:prod:attendance\" \"npm:start:prod:gateway\"",
    "start:prod:employee": "node dist/apps/employee-service/main.js",
    "start:prod:attendance": "node dist/apps/attendance-service/main.js",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.21.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "exif-parser": "^0.1.12",
    "form-data": "^4.0.6",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.2.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "concurrently": "^9.2.5",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~5.6",
    "webpack": "^5.112.2"
  }
}
